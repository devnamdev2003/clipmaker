# Copy this file to ".env" (same folder as main.py) and fill in your values.
# You can also set the first three from the Settings button inside the app.

# --- Gemini (AI clip detection + titles/hashtags) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- YouTube download (age-restricted / "not a bot" videos) ---
# One of: None, chrome, edge, firefox, brave, opera, safari
COOKIES_BROWSER=None

# --- YouTube upload (all optional) ---
# Default visibility in the upload window: private | unlisted | public
YOUTUBE_PRIVACY=private
# 22 People & Blogs, 24 Entertainment, 23 Comedy, 27 Education, 28 Science & Tech
YOUTUBE_CATEGORY_ID=22
# Language of the videos, e.g. en or hi (leave empty to let YouTube decide)
YOUTUBE_LANGUAGE=
# Must be true only if the clips are made for kids
YOUTUBE_MADE_FOR_KIDS=false
# Send a notification to your subscribers for every upload
YOUTUBE_NOTIFY_SUBSCRIBERS=false
# Add #Shorts to the description of vertical clips
YOUTUBE_ADD_SHORTS_TAG=true

# --- Instagram Reels upload (all optional - see INSTAGRAM_SETUP.md) ---
# Long-lived access token and your Instagram user id (the long number, NOT your @username)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Also show the Reel on your profile grid
INSTAGRAM_SHARE_TO_FEED=true
# Post to Instagram automatically as soon as the YouTube upload has finished (Reels are PUBLIC immediately)
INSTAGRAM_AUTO_AFTER_YOUTUBE=false
# Only change these if Meta retires the API version or you use an "Instagram Login" token
INSTAGRAM_API_VERSION=v23.0
INSTAGRAM_GRAPH_HOST=https://graph.facebook.com
